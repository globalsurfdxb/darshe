# ---------------------------------------------------------------------------
# DarShe environment variables. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Database
#   Local development (SQLite):  file:./dev.db
#   Production (PostgreSQL):     postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# The Prisma scripts pick the matching schema automatically from this value.
DATABASE_URL="file:./dev.db"

# Admin area (/admin). Use a long, unique password.
ADMIN_PASSWORD="change-me-to-a-long-passphrase"
# Signs the admin session cookie. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Salt for hashing IP addresses (SHA-256). Raw IPs are never stored.
IP_HASH_SALT="replace-with-another-random-string"

# Public site URL (used for canonical and Open Graph URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
